# JobTrack environment configuration.
# Copy to `.env` and fill in values. NEVER commit `.env` (it is gitignored).
# Every variable is documented in docs/setup/environment-variables.md.

# --- Database (required) ------------------------------------------------------
# MySQL 8 connection URL. URL-encode special characters in the password.
# Local Docker database (docker compose up -d):
DATABASE_URL="mysql://jobtrack:jobtrack@localhost:3307/jobtrack"
# Optional: only if the DB user cannot CREATE DATABASE (needed by `prisma migrate dev`).
# SHADOW_DATABASE_URL="mysql://user:password@host:3306/jobtrack_shadow"

# --- Authentication (required) ------------------------------------------------
# Password for the single JobTrack user (min 8 chars).
APP_PASSWORD="change-me-to-a-long-password"
# Random secret used to sign session cookies (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# --- Amazon SES ---------------------------------------------------------------
AWS_REGION="us-east-1"
# Leave the keys empty when running with an IAM role (recommended in production).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Verified sender identity in SES (required to send real email).
SES_FROM_EMAIL=""
# Optional display name, e.g. "Jane Doe".
SES_FROM_NAME=""
# Optional Reply-To address.
SES_REPLY_TO=""
# Optional SES configuration set used for delivery-event publishing.
SES_CONFIGURATION_SET=""
# Optional: only accept SNS notifications from this topic ARN.
SES_SNS_TOPIC_ARN=""

# --- Email behaviour ----------------------------------------------------------
# "ses" sends real email; "mock" stores messages in memory (dev/tests only; refused in production).
EMAIL_TRANSPORT="ses"
EMAIL_RATE_LIMIT_PER_HOUR="20"

# --- Storage ------------------------------------------------------------------
# Directory for uploaded documents (relative to the project root or absolute).
STORAGE_DIR="./storage/uploads"
